# 复制到 /etc/lostfound/lostfound.env 并填入真实值，chmod 600
# 注意：本文件为样例，严禁填入真实口令后提交到代码仓库

# 本机 MySQL（5.6.51，库 lostfound，已完成结构升级与数据迁移）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lostfound
DB_USER=root
DB_PASSWORD=__CHANGE_ME__

# 后端仅监听本机，由 Nginx 反代
SERVER_ADDRESS=127.0.0.1

# JWT 密钥（改用随机值后，旧 token 会失效，需重新登录）
JWT_SECRET=__CHANGE_ME_RANDOM_32BYTES_HEX__

# 微信小程序凭证
WX_APPID=__CHANGE_ME__
WX_SECRET=__CHANGE_ME__

# 上传目录：与旧系统历史图片目录共用，旧图经 Nginx /image/ 提供，新图经后端 /uploads/ 提供
UPLOAD_DIR=/home/lostfound/image
UPLOAD_BASE_URL=https://www.globalfinding.com/uploads
